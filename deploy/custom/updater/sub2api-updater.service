[Unit]
Description=Sub2API custom image updater
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/sub2api-updater.env
ExecStart=/usr/bin/python3 /opt/sub2api-updater/updater.py --deploy-dir ${SUB2API_DEPLOY_DIR}
Restart=on-failure
RestartSec=5
RuntimeDirectory=sub2api-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
